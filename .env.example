SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Leave unset to use SQLite locally. Set to the Supabase Postgres connection
# string (Project Settings -> Database -> Connection string) to use Postgres.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Leave unset to use the built-in test-mode keys (config/settings.py). Set
# your own to go live -- get them from Paystack > Settings > API Keys & Webhooks.
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...

# Leave EMAIL_HOST unset to use the console backend (prints emails to the
# runserver log instead of sending them). Set these to send real email via
# Resend's SMTP relay -- get the API key from Resend > API Keys; it doubles
# as EMAIL_HOST_PASSWORD. Port 465 is SSL, not STARTTLS.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=support@yourdomain.com
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_...
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False

# MSREC Assistant (site chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
