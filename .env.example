SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Base URL used for links in outgoing emails.
#  - Local dev: set to your machine so email links work locally.
#  - Production: leave UNSET to use the live domain default (config/settings.py),
#    or set it explicitly to your real site URL.
SITE_URL=http://127.0.0.1:8000

# Leave unset to use SQLite locally. Set to the Supabase Postgres connection
# string (Project Settings -> Database -> Connection string) to use Postgres.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Leave unset to use the built-in test-mode keys (config/settings.py). Set
# your own to go live -- get them from Paystack > Settings > API Keys & Webhooks.
# PAYSTACK_SECRET_KEY=sk_live_...
# PAYSTACK_PUBLIC_KEY=pk_live_...

# The GHS-per-USD rate used for the "approximately US$x" figure shown
# beside cedi prices for participants outside Ghana (payments/currency.py).
# Fees are always CHARGED in cedis -- this only affects the quoted guide.
# Leave unset to use a live rate, looked up once and cached for six hours;
# set it to pin the rate (e.g. to build in FX headroom, or on a host with
# no outbound internet). With no rate available the dollar line is simply
# omitted rather than guessed.
# USD_GHS_RATE=12.00

# Email delivery. Preferred: set RESEND_API_KEY and the project will
# deliver via Resend's HTTPS API (works on hosts that block outbound SMTP
# ports 25/465/587 -- a very common cause of signup/approval emails
# silently never arriving). The From address MUST be on a domain verified
# in your Resend account, or Resend will reject every send.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=MSREC Secretariat <no-reply@yourdomain.com>
#
# Fallback: SMTP. Only used when RESEND_API_KEY is empty. Leave EMAIL_HOST
# unset too and the project uses the console backend (prints emails to the
# runserver log instead of sending them). Port 465 is SSL, not STARTTLS.
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=re_...
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False

# MSREC Assistant (site chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- BMS / mNotify SMS (notifications/sms.py) ----
# Without BMS_API_KEY nothing is texted: every SMS twin of a PSA email is
# skipped, silently as far as the client is concerned. The sender ID is
# what shows as the "from" on the handset and is capped at 11 characters.
BMS_API_KEY=
BMS_SENDER_ID=MSREC
